# Database (required for /api/bets, /api/diary)
POSTGRES_URL=your_postgres_connection_string

# AI API Keys
# ANTHROPIC_API_KEY is required for /api/consensus (6-persona multi-model consensus)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY optional for /api/predict, /api/allocator
OPENAI_API_KEY=your_openai_api_key
# GEMINI_API_KEY optional for future use
GEMINI_API_KEY=your_gemini_api_key

# App URL (required for internal API calls)
NEXT_PUBLIC_APP_URL=https://btc-trustee-quant-v3.vercel.app

# ML Backend (required for /api/ml)
ML_BACKEND_URL=https://your-ml-backend.com

# Kalshi API (required for Kalshi market data integration)
KALSHI_KEY_ID=your_kalshi_key_id
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_private_key_here\n-----END RSA PRIVATE KEY-----"

# Novu Notifications (optional - for push notifications)
NOVU_API_KEY=your_novu_api_key
NOVU_APP_ID=your_novu_app_id
NOVU_SAFE_BET_TEMPLATE_ID=safe-bet-alert

# Metrics API Protection (optional - adds auth to /api/metrics)
METRICS_API_KEY=your_secret_metrics_key

# Redis (optional - for caching)
REDIS_URL=redis://your-redis-url

# CF Benchmarks (optional - for BRTI settlement data)
CF_BENCHMARKS_API_KEY=your_cf_benchmarks_api_key

# Stripe (optional - for real payments, currently mocked)
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# WebSocket CORS (optional - restricts websocket origins)
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Clerk Auth (required for authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret
